# YouTube Automation Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# Text LLM (OpenAI-compatible router, same setup as Hermes on ubuntu-main)
# Tried first for scripts, SEO descriptions and image prompts; Gemini is the last fallback.
LLM_BASE_URL=https://omniroute.himalayan-everest.ts.net/v1
LLM_API_KEY=your-router-api-key-here
LLM_MODEL=antigravity/gemini-pro-agent
# Comma-separated extra models on the same router, tried in order if the primary fails
# LLM_FALLBACK_MODELS=auto/best-fast

# Second router (9router), tried after the primary router's models
LLM_FALLBACK_BASE_URL=https://9router-proxy.himalayan-everest.ts.net/v1
LLM_FALLBACK_API_KEY=your-9router-api-key-here
LLM_FALLBACK_ENDPOINT_MODELS=ag/gemini-pro-agent,openrouter/openrouter/free

# Image generation via router (POST {IMAGE_BASE_URL}/images/generations)
# IMAGE_BASE_URL / IMAGE_API_KEY default to the 9router values above when unset.
IMAGE_PROVIDER=router
IMAGE_MODEL=ag/gemini-3.1-flash-image
# IMAGE_BASE_URL=
# IMAGE_API_KEY=

# OpenAI Configuration (Optional if Gemini is configured)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini Configuration (Alternative to OpenAI)
GEMINI_API_KEY=your-gemini-api-key-here

# Application Settings
NODE_ENV=production
PORT=3456
LOG_LEVEL=info

# Channel Settings
CHANNEL_NAME=Your Channel Name
DEFAULT_AUTHOR=Your Name
TARGET_AUDIENCE=Your target audience description

# YouTube Settings
YOUTUBE_REGION=US
DEFAULT_PRIVACY_STATUS=public

# Content Settings
AUTO_SHORTEN_CONTENT=true
AUTO_ADD_BACKLINKS=true
PRESERVE_FORMATTING=true
AUTO_RESIZE_IMAGES=true
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=720
IMAGE_QUALITY=90

# Rate Limiting
GLOBAL_RATE_LIMIT_PER_HOUR=50
DEFAULT_DELAY_BETWEEN_POSTS=60000

# TTS Settings (Text-to-Speech)
# Provider: edge_tts (free default) | openai | elevenlabs | local
TTS_PROVIDER=edge_tts
TTS_VOICE=id-ID-GadisNeural

# ElevenLabs (optional - premium quality voice cloning)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-voice-id

# Local/Custom TTS API Server (optional - for F5-TTS, XTTS v2, CosyVoice, etc.)
# LOCAL_TTS_URL=http://localhost:8000

# Security
JWT_SECRET=generate-a-random-secret-here

# Analytics & Monitoring
ENABLE_ANALYTICS=true
ANALYTICS_DB_PATH=./data/analytics.db

# File Upload Settings
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Error Handling
RETRY_ATTEMPTS=3
RETRY_DELAY=5000
